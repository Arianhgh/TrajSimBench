# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# Local/restricted data and generated artifacts
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
results/*
!results/.gitkeep
analysis*/
# Keep the source package tracked; only generated analysis output is ignored.
!trajsimbench/analysis/
!trajsimbench/analysis/**
# Keep import cache files from making experiment provenance appear dirty.
trajsimbench/analysis/__pycache__/
*.parquet
*.npy
*.npz
*.provenance.json

# Local machine state
tmp/
.env
.DS_Store
*.log
